# Normalize text files to LF on every platform.
* text=auto eol=lf

# Unity serializes these project files as text (Force Text).
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf

# Windows command scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets unchanged and disable text diff/merge.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.psd binary
*.tga binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
*.dll binary
*.pdb binary
*.bin binary
*.bundle binary
*.unitypackage binary
*.zip binary
*.gz binary
*.br binary
*.pdf binary
